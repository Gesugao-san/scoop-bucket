      "Carnotite",
      "Carthum Conglomerate",
      "CASE WHEN (SELECT value FROM TYPE_ATTRIBUTES ",
      "CASE WHEN ACTIVITY_ID = -2 THEN ",
      "CASE WHEN ALL_BLUEPRINTS.FAVORITE IS NOT NULL THEN ALL_BLUEPRINTS.FAVORITE ELSE 0 END AS MY_FAVORITE ",
      "CASE WHEN ALL_BLUEPRINTS.FAVORITE IS NULL THEN 0 ELSE ALL_BLUEPRINTS.FAVORITE END AS FAVORITE, IGNORE, ",
      "CASE WHEN CHAR_SKILLS.ACTIVE_SKILL_LEVEL IS NULL THEN 0 ELSE CHAR_SKILLS.ACTIVE_SKILL_LEVEL END AS ACTIVE_SKILL_LEVEL,",
      "CASE WHEN CHAR_SKILLS.OVERRIDE_LEVEL IS NULL THEN 0 ELSE CHAR_SKILLS.OVERRIDE_LEVEL END AS OVERRIDE_LEVEL ",
      "CASE WHEN CHAR_SKILLS.OVERRIDE_SKILL IS NULL THEN 0 ELSE CHAR_SKILLS.OVERRIDE_SKILL END AS OVERRIDE_SKILL,",
      "CASE WHEN CHAR_SKILLS.SKILL_POINTS IS NULL THEN 0 ELSE CHAR_SKILLS.SKILL_POINTS END AS SKILL_POINTS,",
      "CASE WHEN CHAR_SKILLS.TRAINED_SKILL_LEVEL IS NULL THEN 0 ELSE CHAR_SKILLS.TRAINED_SKILL_LEVEL END AS TRAINED_SKILL_LEVEL,",
      "CASE WHEN COST_INDEX IS NULL THEN 0 ELSE COST_INDEX END AS COST_INDEX,",
      "CASE WHEN effectID IS NULL THEN -1 ELSE effectID END AS EffID, ",
      "CASE WHEN effectID IS NULL THEN -1 ELSE effectID END AS EffID, groupName, ",
      "CASE WHEN groupName = 'Ice' THEN 'Ice' WHEN groupName LIKE '%Moon%' THEN 'Moon Ore' ELSE 'Ore' END AS ORE_GROUP FROM ORES, ORE_LOCATIONS, INVENTORY_GROUPS, INVENTORY_TYPES ",
      "CASE WHEN INDUSTRY_LINES IS NULL THEN 1 ELSE INDUSTRY_LINES END AS INDUSTRY_LINES, ",
      "CASE WHEN ITEM_GROUP = 'Ice' OR ITEM_GROUP LIKE '%Moon%' THEN CASE WHEN SUBSTR(ORE_NAME,1,10) ='Compressed' THEN SUBSTR(ORE_NAME,12) ELSE ORE_NAME END ELSE ITEM_GROUP END AS ORE_GROUP ",
      "CASE WHEN JOB_COUNT IS NULL THEN 0 ELSE JOB_COUNT END AS JOB_COUNT, ",
      "CASE WHEN jobType =1 THEN 'Corporation' ELSE 'Personal' END AS 'Job Type' ",
      "CASE WHEN REACTION_JOBS IS NULL THEN 0 ELSE REACTION_JOBS END AS REACTION_JOBS, ",
      "CASE WHEN REACTION_LINES IS NULL THEN 1 ELSE REACTION_LINES END AS REACTION_LINES ",
      "CASE WHEN REGIONS.regionName Is Not NULL THEN REGIONS.regionName ELSE 'Unknown Region' END AS 'Install Region',",
      "CASE WHEN RESEARCH_JOBS IS NULL THEN 0 ELSE RESEARCH_JOBS END AS RESEARCH_JOBS, ",
      "CASE WHEN RESEARCH_LINES IS NULL THEN 1 ELSE RESEARCH_LINES END AS RESEARCH_LINES, ",
      "CASE WHEN S1.STATION_NAME IS NOT NULL THEN S1.STATION_NAME ELSE ",
      "CASE WHEN S2.STATION_NAME IS NOT NULL THEN S2.STATION_NAME ELSE ",
      "CASE WHEN TE IS NULL THEN 0 ELSE TE END AS BP_TE ",
      "CASE WHEN UPGRADE_LEVEL IS NULL THEN 0 ELSE UPGRADE_LEVEL END AS FW_UPGRADE_LEVEL, SF.ACTIVITY_COST_PER_SECOND, ",
      "CASE WHEN value IS NULL THEN -1 ELSE value END AS RIG_SIZE ",
      "CASE WHEN value IS NULL THEN -1 ELSE value END AS RIG_SIZE, ",
