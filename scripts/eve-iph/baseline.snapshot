      "FROM ALL_BLUEPRINT_MATERIALS LEFT OUTER JOIN ITEM_PRICES_FACT On ALL_BLUEPRINT_MATERIALS.MATERIAL_ID = ITEM_PRICES_FACT.ITEM_ID ",
      "FROM ALL_BLUEPRINT_MATERIALS_FACT AS ABM, INVENTORY_TYPES, INVENTORY_GROUPS ",
      "FROM ALL_BLUEPRINTS AS AB, ITEM_PRICES_FACT AS IP, INVENTORY_TYPES ",
      "FROM ALL_BLUEPRINTS LEFT JOIN OWNED_BLUEPRINTS ON ALL_BLUEPRINTS.BLUEPRINT_ID = OWNED_BLUEPRINTS.BLUEPRINT_ID  ",
      "FROM ALL_BLUEPRINTS_FACT INNER JOIN INVENTORY_TYPES ON ALL_BLUEPRINTS_FACT.ITEM_ID = INVENTORY_TYPES.typeID ",
      "FROM ALL_BLUEPRINTS_FACT, ITEM_PRICES_FACT WHERE ALL_BLUEPRINTS_FACT.ITEM_ID = ITEM_PRICES_FACT.ITEM_ID ",
      "FROM ALL_BLUEPRINTS, INVENTORY_TYPES AS IT ",
      "FROM ALL_BLUEPRINTS, INVENTORY_TYPES AS IT, OWNED_BLUEPRINTS ",
      "FROM ESI_CHARACTER_DATA ",
      "FROM ESI_CHARACTER_DATA AS ECD, ESI_CORPORATION_DATA AS ECPD ",
      "FROM ESI_CHARACTER_DATA AS ECHD, ESI_CORPORATION_DATA AS ECRPD ",
      "FROM ESI_CHARACTER_DATA ORDER BY CHARACTER_NAME",
      "FROM INDUSTRY_JOBS, INDUSTRY_ACTIVITIES, ESI_CHARACTER_DATA, ALL_BLUEPRINTS AS ABS ",
      "FROM INVENTORY_GROUPS, INVENTORY_TYPES ",
      "FROM INVENTORY_TYPES WHERE published <> 0 ",
      "FROM INVENTORY_TYPES, INVENTORY_GROUPS, INVENTORY_TYPES AS INVENTORY_TYPES_1, TYPE_ATTRIBUTES, TYPE_ATTRIBUTES AS TYPE_ATTRIBUTES_1, ATTRIBUTE_TYPES ",
      "FROM INVENTORY_TYPES, INVENTORY_GROUPS, ITEM_PRICES LEFT JOIN REPROCESSING ON REPROCESSING.REFINED_MATERIAL_ID = INVENTORY_TYPES.typeID ",
      "FROM INVENTORY_TYPES, TYPE_ATTRIBUTES ",
      "FROM ITEM_PRICES ",
      "FROM ITEM_PRICES, INVENTORY_TYPES WHERE ITEM_PRICES.ITEM_ID = INVENTORY_TYPES.typeID AND (",
      "FROM ORES WHERE BELT_TYPE = 'Ore' ",
      "FROM ORES, ORE_LOCATIONS, ITEM_PRICES WHERE ORES.ORE_ID = ITEM_PRICES.ITEM_ID ",
      "FROM OWNED_BLUEPRINTS AS OBP, ALL_BLUEPRINTS_FACT AS ABF ",
      "FROM PRICE_PROFILES WHERE ID = ",
      "FROM PRICE_PROFILES WHERE ID = 0 ",
      "FROM REGIONS, SOLAR_SYSTEMS ",
      "FROM REPROCESSING, ITEM_PRICES ",
      "FROM RESEARCH_AGENTS, FACTIONS, REGIONS ",
      "FROM RESEARCH_AGENTS, INVENTORY_TYPES, CURRENT_RESEARCH_AGENTS  ",
      "FROM SAVED_FACILITIES ",
      "FROM SAVED_FACILITIES AS SF, FACILITY_PRODUCTION_TYPES, REGIONS, SOLAR_SYSTEMS, FACILITY_TYPES, INDUSTRY_ACTIVITIES ",
      "FROM SKILLS LEFT OUTER JOIN ",
      "FROM STATION_SERVICES, SOLAR_SYSTEMS, STATIONS ",
      "FROM STATIONS WHERE STATION_ID = ",
      "FROM TYPE_ATTRIBUTES AS TA, ENGINEERING_RIG_BONUSES AS ERB, INVENTORY_TYPES AS IT, ATTRIBUTE_TYPES AS AT ",
      "FROM TYPE_ATTRIBUTES AS TA, INVENTORY_TYPES AS IT, ATTRIBUTE_TYPES AS AT ",
      "FROM TYPE_ATTRIBUTES WHERE attributeID IN (2593,2594,2595,2713,2714,2653,717) ",
      "FROM TYPE_ATTRIBUTES, ATTRIBUTE_TYPES ",
      "FROM TYPE_ATTRIBUTES, INVENTORY_TYPES ",
      "FROM TYPE_ATTRIBUTES, INVENTORY_TYPES, INVENTORY_GROUPS ",
      "FROM UPWELL_STRUCTURES WHERE UPWELL_STRUCTURE_TYPE_ID = ",
