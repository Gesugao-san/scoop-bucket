      "Lease",
      "LEFT JOIN (SELECT installerID, COUNT(*) AS JOB_COUNT FROM INDUSTRY_JOBS WHERE STATUS = 'active' AND activityID = 1 GROUP BY installerID) AS L ON L.installerID = ECD.CHARACTER_ID ",
      "LEFT JOIN (SELECT installerID, COUNT(*) AS REACTION_JOBS FROM INDUSTRY_JOBS WHERE STATUS = 'active' AND activityID = 11 GROUP BY installerID) AS N ON N.installerID = ECD.CHARACTER_ID ",
      "LEFT JOIN (SELECT installerID, COUNT(*) AS RESEARCH_JOBS FROM INDUSTRY_JOBS WHERE STATUS = 'active' AND activityID NOT IN (1,11) GROUP BY installerID) AS J ON J.installerID = ECD.CHARACTER_ID ",
      "LEFT JOIN (SELECT SUM({0}) + 1 AS INDUSTRY_LINES, CHARACTER_ID FROM CHARACTER_SKILLS WHERE SKILL_TYPE_ID IN (3387,24625) GROUP BY CHARACTER_ID) AS K ON K.CHARACTER_ID = ECD.CHARACTER_ID ",
      "LEFT JOIN (SELECT SUM({0}) + 1 AS REACTION_LINES, CHARACTER_ID FROM CHARACTER_SKILLS WHERE SKILL_TYPE_ID IN (45748,45749) GROUP BY CHARACTER_ID) AS M ON M.CHARACTER_ID = ECD.CHARACTER_ID ",
      "LEFT JOIN (SELECT SUM({0}) + 1 AS RESEARCH_LINES, CHARACTER_ID FROM CHARACTER_SKILLS WHERE SKILL_TYPE_ID IN (3406,24624) GROUP BY CHARACTER_ID) AS I ON I.CHARACTER_ID = ECD.CHARACTER_ID ",
      "LEFT JOIN CHARACTER_STANDINGS ON STATIONS.CORPORATION_ID = CHARACTER_STANDINGS.NPC_TYPE_ID ",
      "LEFT JOIN CORPORATION_LP_STORE ON AB.BLUEPRINT_ID = CORPORATION_LP_STORE.TYPE_ID ",
      "LEFT JOIN CORPORATION_LP_STORE ON ALL_BLUEPRINTS.BLUEPRINT_ID = CORPORATION_LP_STORE.TYPE_ID ",
      "LEFT JOIN FW_SYSTEM_UPGRADES ON FW_SYSTEM_UPGRADES.SOLAR_SYSTEM_ID = SF.SOLAR_SYSTEM_ID ",
      "LEFT JOIN INDUSTRY_ACTIVITIES ON ERB.activityID = INDUSTRY_ACTIVITIES.activityID ",
      "LEFT JOIN INDUSTRY_SYSTEMS_COST_INDICIES ",
      "LEFT JOIN INDUSTRY_SYSTEMS_COST_INDICIES ON INDUSTRY_SYSTEMS_COST_INDICIES.SOLAR_SYSTEM_ID = STATIONS.SOLAR_SYSTEM_ID ",
      "LEFT JOIN INDUSTRY_SYSTEMS_COST_INDICIES ON solarSystemID = SOLAR_SYSTEM_ID ",
      "LEFT JOIN INVENTORY_CATEGORIES ON ERB.categoryID = INVENTORY_CATEGORIES.categoryID ",
      "LEFT JOIN INVENTORY_GROUPS ON ERB.groupID = INVENTORY_GROUPS.groupID ",
      "LEFT JOIN REGIONS ON SOLAR_SYSTEMS.regionID = REGIONS.regionID ",
      "LEFT JOIN SOLAR_SYSTEMS ON STATIONS.SOLAR_SYSTEM_ID = SOLAR_SYSTEMS.solarSystemID ",
      "LEFT JOIN STATIONS ON STATIONS.STATION_ID = INDUSTRY_JOBS.locationID ",
      "LEFT JOIN TYPE_ATTRIBUTES ON INVENTORY_TYPES.typeID = TYPE_ATTRIBUTES.typeID ",
      "LEFT JOIN TYPE_EFFECTS ON INVENTORY_TYPES.typeID = TYPE_EFFECTS.typeID AND effectID IN (12,13,11) ",
      "LEFT OUTER JOIN (SELECT STATION_ID, STATION_NAME FROM STATIONS) AS S1 ON S1.STATION_ID = INDUSTRY_JOBS.blueprintLocationID ",
      "LEFT OUTER JOIN (SELECT STATION_ID, STATION_NAME FROM STATIONS) AS S2 ON S2.STATION_ID = INDUSTRY_JOBS.outputLocationID ",
      "LEFT OUTER JOIN (SELECT STATION_ID, STATION_NAME FROM STATIONS) AS S3 ON S3.STATION_ID = INDUSTRY_JOBS.locationID ",
      "LEFT OUTER JOIN (SELECT STATION_ID, STATION_NAME, A1.ItemID FROM STATIONS LEFT OUTER JOIN (SELECT LocationID, ItemID FROM ASSETS WHERE ID = ",
      "LEFT OUTER JOIN (SELECT STATION_ID, STATION_NAME, A2.ItemID FROM STATIONS LEFT OUTER JOIN (SELECT LocationID, ItemID FROM ASSETS WHERE ID = ",
      "LEFT OUTER JOIN (SELECT typeID, typeName FROM INVENTORY_TYPES) AS IT2 ON IT2.typeID = INDUSTRY_JOBS.blueprintLocationID ",
      "LEFT OUTER JOIN (SELECT typeID, typeName FROM INVENTORY_TYPES) AS IT3 ON IT3.typeID = INDUSTRY_JOBS.outputLocationID ",
      "LEFT OUTER JOIN ALL_BLUEPRINTS_FACT ON ALL_BLUEPRINTS_FACT.ITEM_ID = ABM.MATERIAL_ID ",
      "LEFT OUTER JOIN ITEM_PRICES_FACT ON ABM.MATERIAL_ID = ITEM_PRICES_FACT.ITEM_ID ",
