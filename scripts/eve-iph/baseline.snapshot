      "(ITEM_CATEGORY IN ('Drone', 'Fighter') AND ",
      "(ITEM_CATEGORY IN ('Starbase','Structure') OR ITEM_GROUP = 'Station Components')",
      "(ITEM_GROUP = 'Cyberimplant' OR (ITEM_CATEGORY = 'Implant' AND ITEM_GROUP <> 'Booster')) OR ",
      "(ITEM_GROUP IN ('Materials and Compounds','Artifacts and Prototypes','Rogue Drone Components') OR ITEM_GROUP LIKE 'Decryptors -%') OR ",
      "(ITEM_GROUP LIKE '%Components%' AND ITEM_GROUP <> 'Station Components')",
