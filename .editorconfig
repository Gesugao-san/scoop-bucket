# EditorConfig: https://editorconfig.org

root = true

# Manifests use Scoop's own format (4-space JSON, CRLF): Excavator rewrites them with Scoop's
# formatter on every update, so keeping that format avoids whitespace-only diffs.
[*]
charset = utf-8
end_of_line = crlf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{ps1,psm1,yml,yaml}]
indent_size = 2
