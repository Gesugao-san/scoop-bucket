    "uninstaller": {
        "script": [
            "# Start with Windows writes 'Impactor' = '<exe path> --tray' to HKCU Run (auto-launcher crate).",
            "# The path goes through 'current', so it survives updates; only a real uninstall removes it.",
            "if ($cmd -eq 'uninstall') {",
            "    $runKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Run'",
            "    $approvedKey = 'HKCU:\\Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\StartupApproved\\Run'",
            "    $entry = (Get-ItemProperty -Path $runKey -Name 'Impactor' -ErrorAction SilentlyContinue).Impactor",
            "    if ($entry -and $entry -like \"$(Split-Path $dir)\\*\") {",
            "        Remove-ItemProperty -Path $runKey -Name 'Impactor' -ErrorAction SilentlyContinue",
            "        Remove-ItemProperty -Path $approvedKey -Name 'Impactor' -ErrorAction SilentlyContinue",
            "    }",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/claration/impactor"
    },
