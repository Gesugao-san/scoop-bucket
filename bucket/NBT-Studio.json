{
    "version": "1.15.3",
    "description": "NBT viewer and editor, spiritual successor to NBTExplorer. Java and Bedrock NBT, SNBT, region files.",
    "homepage": "https://github.com/tryashtar/nbt-studio",
    "license": "Unknown",
    "notes": [
        "NBT Studio is a framework-dependent build and needs the .NET 6 Desktop Runtime (x64).",
        "Check with: dotnet --list-runtimes   (look for Microsoft.WindowsDesktop.App 6.0.x)",
        "If it is missing, install it in one of these ways (both run Microsoft's installer):",
        "  scoop bucket add versions",
        "  scoop install versions/windowsdesktop-runtime-6.0   (needs admin)",
        "or",
        "  winget install Microsoft.DotNet.DesktopRuntime.6",
        "Scoop's suggestion below only sees runtimes installed through Scoop.",
        "",
        "To register file associations (.nbt by default, 'Open with' for other NBT formats), execute:",
        "reg import \"$dir\\install-associations.reg\""
    ],
    "suggest": {
        ".NET 6 Desktop Runtime": "versions/windowsdesktop-runtime-6.0"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/tryashtar/nbt-studio/releases/download/v1.15.3/NbtStudio.exe",
            "hash": "f3204aad72655af4108cd161f329229b63617b4faf81b17860b499e5b9047eb9"
        }
    },
    "post_install": [
        "$templates = Join-Path (Find-BucketDirectory -Name $bucket -Root) \"scripts\\$($app.ToLowerInvariant())\"",
        "if (!(Test-Path -LiteralPath $templates -PathType Container)) {",
        "  warn \"Registry templates not found in '$templates', file associations are unavailable.\"",
        "  return",
        "}",
        "$app_dir = $dir -replace '\\\\', '\\\\'",
        "Get-ChildItem -Path $templates -Filter '*.reg' -File | ForEach-Object {",
        "  $content = Get-Content -Path $_.FullName -Encoding utf8",
        "  if ($global) { $content = $content -replace 'HKEY_CURRENT_USER', 'HKEY_LOCAL_MACHINE' }",
        "  $content -replace '{{nbtstudio_dir}}', $app_dir | Set-Content -Path \"$dir\\$($_.Name)\" -Encoding unicode",
        "}"
    ],
    "bin": "NbtStudio.exe",
    "shortcuts": [
        [
            "NbtStudio.exe",
            "NBT Studio"
        ]
    ],
    "uninstaller": {
        "script": [
            "if ($cmd -eq 'uninstall') {",
            "  reg import \"$dir\\uninstall-associations.reg\" *> $null",
            "}"
        ]
    },
    "checkver": {
        "github": "https://github.com/tryashtar/nbt-studio"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/tryashtar/nbt-studio/releases/download/v$version/NbtStudio.exe"
            }
        }
    }
}
