{
    "version": "12.2",
    "description": "Software reverse engineering framework by the NSA: disassembler, decompiler, debugger, Java and Python scripting, headless analysis.",
    "homepage": "https://github.com/NationalSecurityAgency/ghidra",
    "license": {
        "identifier": "Apache-2.0",
        "url": "https://github.com/NationalSecurityAgency/ghidra/blob/HEAD/LICENSE"
    },
    "notes": [
        "Ghidra needs a 64-bit JDK 25 (a JRE is not enough) on the PATH or in JAVA_HOME.",
        "If it finds none, the launcher asks for the JDK folder on the first start and remembers it.",
        "With Scoop: scoop bucket add java; scoop install java/temurin25-jdk",
        "",
        "Settings live outside the Scoop folder and survive updates;",
        "Ghidra shows where: Help > Runtime Information > Application Layout > Settings Directory.",
        "Keep your projects outside the Scoop folder too.",
        "",
        "Commands: ghidraRun (GUI), analyzeHeadless, pyghidraRun (needs Python 3.9-3.15 as 'py' or 'python')."
    ],
    "suggest": {
        "JDK 25": "java/temurin25-jdk"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_12.2_build/ghidra_12.2_PUBLIC_20261016.zip",
            "hash": "2c2cd776db3c1f6a097ba418922378ac3649cadd5e844a6f5f088ae628a7be67"
        }
    },
    "extract_dir": "ghidra_12.2_PUBLIC",
    "bin": [
        "ghidraRun.bat",
        "support\\analyzeHeadless.bat",
        "support\\pyghidraRun.bat"
    ],
    "shortcuts": [
        [
            "ghidraRun.bat",
            "Ghidra",
            "",
            "support\\ghidra.ico"
        ]
    ],
    "env_set": {
        "GHIDRA_INSTALL_DIR": "$dir"
    },
    "checkver": {
        "url": "https://api.github.com/repos/NationalSecurityAgency/ghidra/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "ghidra_([\\d.]+)_PUBLIC_(?<releasedate>\\d{8})\\.zip"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_$version_build/ghidra_$version_PUBLIC_$matchReleasedate.zip"
            }
        },
        "hash": {
            "url": "https://github.com/NationalSecurityAgency/ghidra/releases/tag/Ghidra_$version_build",
            "regex": "<code>$sha256</code>"
        },
        "extract_dir": "ghidra_$version_PUBLIC"
    }
}
