{
    "version": "1.68",
    "description": "Decentralized P2P file sharing: search other users' shared libraries, browse their folders, chat rooms and private messages, no central server.",
    "homepage": "https://www.fopnu.com",
    "license": {
        "identifier": "Freeware",
        "url": "https://github.com/Gesugao-san/scoop-bucket/blob/HEAD/licenses/Fopnu.txt"
    },
    "notes": [
        "Settings, the library and transfers live in %APPDATA%\\fopnu, survive updates and are kept on uninstall.",
        "If Fopnu offers a new version, update with 'scoop update Fopnu' instead of running its installer."
    ],
    "architecture": {
        "64bit": {
            "url": "https://download2.fopnu.com/download/fopnu-1.68-1.win64-install.exe#/dl.7z",
            "hash": "0bdfe08456266779b487096eeb12715c7037bb6ad11408f187c8a386c62311ca"
        },
        "32bit": {
            "url": "https://download2.fopnu.com/download/fopnu-1.68-1.win32-install.exe#/dl.7z",
            "hash": "794bcd7177f105c3cbd07a344246dea6e8128a9d1cb1c644e59bccca85f87e86"
        }
    },
    "pre_install": [
        "# The installer is a small stub with fopnu.exe as a bzip2 resource; 7-Zip unpacks it as '<id>~'.",
        "Get-ChildItem \"$dir\\*~\" | Select-Object -First 1 | Rename-Item -NewName 'fopnu.exe'"
    ],
    "bin": "fopnu.exe",
    "shortcuts": [
        [
            "fopnu.exe",
            "Fopnu"
        ]
    ],
    "checkver": {
        "url": "https://www.fopnu.com/download/windows64.html",
        "regex": "fopnu-([\\d.]+)-(?<build>\\d+)\\.win64-install\\.exe"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://download2.fopnu.com/download/fopnu-$version-$matchBuild.win64-install.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://download2.fopnu.com/download/fopnu-$version-$matchBuild.win32-install.exe#/dl.7z"
            }
        }
    }
}
