{
    "version": "2026.05.27",
    "description": "Open-source x64/x32 debugger for Windows: x96dbg launcher, x64dbg, x32dbg, plugins, scripting, Scylla import reconstruction.",
    "homepage": "https://x64dbg.com",
    "license": {
        "identifier": "GPL-3.0-only",
        "url": "https://github.com/x64dbg/x64dbg/blob/HEAD/LICENSE"
    },
    "notes": [
        "Settings (*.ini), databases, plugins, symbols and memory dumps are persisted and survive updates.",
        "Put plugins into $persist_dir\\release\\x64\\plugins (or x32\\plugins).",
        "Update with 'scoop update x64dbg'."
    ],
    "url": "https://github.com/x64dbg/x64dbg/releases/download/2026.05.27/snapshot_2026-05-27_12-11.zip",
    "hash": "d41966dfc5b435a372798245300ca0ab7bb8e48bdbf48512c6fb20fcca427697",
    "pre_install": [
        "'release\\x96dbg.ini', 'release\\x32\\x32dbg.ini', 'release\\x64\\x64dbg.ini' | ForEach-Object {",
        "  if (!(Test-Path \"$persist_dir\\$_\")) { New-Item -ItemType File \"$dir\\$_\" | Out-Null }",
        "}"
    ],
    "architecture": {
        "64bit": {
            "bin": [
                "release\\x96dbg.exe",
                "release\\x32\\x32dbg.exe",
                "release\\x64\\x64dbg.exe"
            ],
            "shortcuts": [
                [
                    "release\\x96dbg.exe",
                    "x96dbg"
                ],
                [
                    "release\\x32\\x32dbg.exe",
                    "x32dbg"
                ],
                [
                    "release\\x64\\x64dbg.exe",
                    "x64dbg"
                ]
            ]
        },
        "32bit": {
            "bin": [
                "release\\x96dbg.exe",
                "release\\x32\\x32dbg.exe"
            ],
            "shortcuts": [
                [
                    "release\\x96dbg.exe",
                    "x96dbg"
                ],
                [
                    "release\\x32\\x32dbg.exe",
                    "x32dbg"
                ]
            ]
        }
    },
    "persist": [
        "release\\x96dbg.ini",
        "release\\x32\\x32dbg.ini",
        "release\\x32\\db",
        "release\\x32\\plugins",
        "release\\x32\\symbols",
        "release\\x32\\memdumps",
        "release\\x32\\garbage",
        "release\\x64\\x64dbg.ini",
        "release\\x64\\db",
        "release\\x64\\plugins",
        "release\\x64\\symbols",
        "release\\x64\\memdumps",
        "release\\x64\\garbage"
    ],
    "checkver": {
        "url": "https://api.github.com/repos/x64dbg/x64dbg/releases/latest",
        "jsonpath": "$.assets[*].browser_download_url",
        "regex": "download/([\\d.]+)/snapshot_(?<snapshot>[\\d-]+_[\\d-]+)\\.zip"
    },
    "autoupdate": {
        "url": "https://github.com/x64dbg/x64dbg/releases/download/$version/snapshot_$matchSnapshot.zip"
    }
}
